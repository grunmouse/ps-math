
{(math.ps) stealfile} /min ifnotkey
{(2d.ps) stealfile} /2div ifnotkey

/2cvi {
	cvi
	exch
	cvi
	exch
} def

%Функции для работы с парами чисел как с простыми дробями

%[a, b]
/NOD {
	{
		2 copy eq {exit} if
		max
		%[меньшее, больше]
		1 index
		%[меньшее, больше, меньшее]
		dup 0 eq {
			pop exch exit
		} if
		mod
		%[меньшее, остаток]
	} loop
	pop
} def

%[a, b]
/NOK {
	2 copy NOD div mul cvi
} def

%[nom, den]
/fraction-reduce {
	2 dict begin 
		/den exch def
		/nom exch def
		nom 0 eq {
			0 1
		}
		{
			nom 0 lt {
				nom neg den 
				fraction-reduce
				exch neg exch
			}
			{
				nom den
				2dup
				NOD
				2div 2cvi
			} ifelse
		} ifelse
	end
} def
%[nom, den]

%[nom1, den1, nom2, den2] - две пары чисел, трактуемые как дроби
/common-denominator {
	6 dict begin
		/den2 exch def
		/nom2 exch def
		/den1 exch def
		/nom1 exch def
		
		den1 den2 eq
		%then
		{
			%Если знаменатели равны, то возвращаем исходные дроби
			nom1 den1 nom2 den2
		} 
		%else
		{
			den1 den2 2 copy NOD 2div 2cvi
			/mul1 exch def
			/mul2 exch def
			%mul1 = den2/NOD
			%mul2 = den1/NOD
			
			nom1 den1 mul1 2mul
			nom2 den2 mul2 2mul
		}
		ifelse
	end
} def
%[nom1, den1, nom2, den2] - две пары чисел, трактуемые как дроби. После работы den1 = den2


%[nom1, den1]
/fraction-neg {
	exch
	neg
	exch
} def
%[-nom1, den1]

%Складывает дроби
/fraction-add {
	common-denominator
	pop
	%[nom1, den, nom2]
	3 -1 roll
	%[den, nom2, nom1]
	add
	exch
	%[nom1+nom2, den]
} def

%Вычитает дроби
/fraction-sub {
	common-denominator
	pop
	%[nom1, den, nom2]
	3 -1 roll
	%[den, nom2, nom1]
	exch
	sub
	exch
	%[nom1-nom2, den]
} def

%Умножает дроби
/fraction-mul {
	4 dict begin
		/den2 exch def
		/nom2 exch def
		/den1 exch def
		/nom1 exch def
		
		nom1 nom2 mul
		den1 den2 mul
	end
} def

%Делит дроби
/fraction-div {
	4 dict begin
		/den2 exch def
		/nom2 exch def
		/den1 exch def
		/nom1 exch def
		
		nom1 den2 mul
		den1 nom2 mul
	end
} def

%Равенство дробей
/fraction-eq {
	fraction-div
	eq
} def


/fraction-has-div {
	fraction-div
	fraction-reduce
	exch pop
	1 eq
} def

%initial increment limit proc for
%[init_nom, init_den, inc_nom, inc_den, limit_nom, limit_den, proc]
/fraction-for {
	8 dict begin
		/proc exch def
		/limit_den exch def
		/limit_nom exch def
		/inc_den exch def
		/inc_nom exch def
		/init_den exch def
		/init_nom exch def
		
		
		/common_den limit_den inc_den NOK init_den NOK def
		
		init_nom common_den init_den div mul cvi
		inc_nom common_den inc_den div mul cvi
		limit_nom common_den limit_den div mul cvi

		{
			%[item_nom]
			
			common_den
			fraction-reduce
			proc
		} for
	end
} def

%[fun]
/find-10 {
	0 dict begin
		/fun exch def
		/find-inner-p 10 def
		/find-inner-n 0 def
		
		/find-inner-x 5 def
		{
			find-inner-x fun
			dup 0 eq {
				pop
				find-inner-x find-inner-x true exit
			} 
			{
				0 lt {
					/find-inner-n find-inner-x def
				}
				{
					/find-inner-p find-inner-x def
				}
				ifelse
			}
			ifelse
			
			find-inner-p find-inner-n sub 1 eq {
				find-inner-n find-inner-p false exit
			} if
		
			/find-inner-x find-inner-p find-inner-n add 2 div round cvi def
			find-inner-x find-inner-n eq
			find-inner-x find-inner-p eq
			or
			{
				(HZ) ==
				false false false exit
			}
			if

		} loop
	end
} def

%Находит рациональную дробь для десятичной дроби с точностью три знака после запятой
/by1000-tofrac {
	0 dict begin
		/by1000-inner-x exch def
		/by1000-inner-n by1000-inner-x floor def
		
		{10 div by1000-inner-n add by1000-inner-x sub} find-10
		%[n p is]
		{
			pop
			by1000-inner-n 10 mul add cvi 10 true
		}
		{
			pop
			10 div by1000-inner-n add /by1000-inner-n exch def
			%by1000-inner-n ==
			{100 div by1000-inner-n add by1000-inner-x sub} find-10
			{
				pop
				by1000-inner-n 100 mul add cvi 100 true
			}
			{
				pop
				100 div by1000-inner-n add /by1000-inner-n exch def
				{1000 div by1000-inner-n add by1000-inner-x sub} find-10
				{
					pop
					by1000-inner-n 1000 mul add cvi 1000 true
				}
				{
					pop pop
					by1000-inner-x false
				}
				ifelse
			}
			ifelse
		}
		ifelse
		
	end
} def

/real-tofrac {
	0 dict begin
		/x exch def
		/y x round def
		x y eq
		{
			y cvi
			1
		} 
		{
			x by1000-tofrac
			{
				%ничего
			}
			{
				1000 mul round cvi 1000
			}
			ifelse
		}
		ifelse
	end
} def

%Преобразует аргумент в пару значений nom den
/tofrac {
	dup type
	<<
		/arraytype {0 2 getinterval aload pop}
		/dicttype {begin nom den end}
		/realtype {real-tofrac}
		/integertype {1}
	>>
	exch get exec
} def